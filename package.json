{
  "name": "prompt-compiler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --sort build",
    "check": "pnpm lint && pnpm test",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.ts\" \"*.config.*\"",
    "pcr": "node apps/pcr-cli/dist/bin.js",
    "pcr-mcp": "node apps/pcr-mcp/dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --sort typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
