{
  "name": "@pcr/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && essencekit build dev",
    "build:prod": "tsc -p tsconfig.json && essencekit build prod",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "python3 -m http.server 4174 -d Pub"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "essencekit": "github:essencekit/essencekit",
    "fs-extra": "^11.3.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  }
}
